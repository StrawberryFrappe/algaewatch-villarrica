# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Raw downloads are regenerated by the pipeline and can be large — not committed.
# data/processed/ (collected FAI series, grid, training table) and
# src/model/artifacts/ (trained model) ARE committed on purpose, so the repo
# is reproducible without re-hitting the Sentinel-2/CDS APIs (~20-40 min).
data/raw/**/*
!data/raw/**/.gitkeep

# Secrets
.env
*.env.local

# OS/editor
.DS_Store
.vscode/
