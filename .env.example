# Copy to `.env` ONE DIRECTORY ABOVE this repo's root (e.g. next to wherever
# you clone this into), never inside it — python-dotenv's find_dotenv() walks
# up automatically, and this keeps real credentials structurally outside the
# git tree instead of relying only on .gitignore.

# ERA5-Land hourly via CDS API (cdsapi). Accept the dataset licence once at
# https://cds.climate.copernicus.eu/datasets/reanalysis-era5-land?tab=download
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_TOKEN=

# Sentinel-2 via Copernicus Data Space Ecosystem (sentinelhub-py)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Gemini 2.5 Flash — generates the "Análisis IA" panel text server-side
GEMINI_API_KEY=

# Optional — backend/app/config.py
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
